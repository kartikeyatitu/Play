model VerificationToken {
  id        String   @id @default(cuid())
  phone     String
  token     String
  attempts  Int      @default(0) // wrong guesses against this phone's code; the code is burned after 5
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([phone, token])
}

// One-tap login links generated by an academy admin (shared on WhatsApp).
// Only the sha256 hash of the token is stored; tokens are single-use and expire.
model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdById String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FeeRecord {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Float     @default(0)
  month     String // Format: "YYYY-MM"
  status    String    @default("PENDING") // PENDING, PAID
  paymentMethod String? // OFFLINE_RECORDED | PARENT_REPORTED_UPI | ADMIN_CONFIRMED_UPI | ONLINE_VERIFIED (null = legacy)
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  updatedAt DateTime @updatedAt

  @@unique([studentId, month])
  orgId       String?
  receipt     Receipt?
  @@index([orgId, month, status])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String
  createdAt DateTime @default(now())
  authorId  String
  orgId       String?
  batchId   String? // null = whole academy; set = only parents of this batch
  kind      String? // GENERAL, RECAP, CANCELLATION
}

model SkillReport {
  id         String   @id @default(cuid())
  studentId  String
  coachId    String
  month      String // "YYYY-MM"
  technique  Int      @default(3) // 1-5 stars (legacy — kept for backward compat)
  fitness    Int      @default(3)
  discipline Int      @default(3)
  sport      String?  // sport at time of evaluation (denormalized from batch)
  metrics    Json?    // sport-specific scores: { "batting": 4, "bowling": 3, … }
  notes      String?
  createdAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coach   User    @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([studentId, month])
  orgId       String?
}

model Event {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  location  String?
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rsvps     RSVP[]
  createdAt DateTime @default(now())
  Student   Student? @relation(fields: [studentId], references: [id])
  studentId String?
  orgId       String?
}

model RSVP {
  id        String  @id @default(cuid())
  eventId   String
  studentId String
  status    String // "GOING", "NOT_GOING", "PENDING"
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  User      User?   @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([eventId, studentId])
  orgId       String?
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(100)
  createdAt   DateTime @default(now())
  orders      Order[]
  orgId       String?
}

model Order {
  id        String   @id @default(cuid())
  productId String
  studentId String
  status    String   @default("PENDING") // PENDING, DELIVERED
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  orgId       String?
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  orgId       String?
  @@index([orgId, createdAt])
  @@index([receiverId])
  @@index([senderId])
}

model Media {
  id        String   @id @default(cuid())
  studentId String
  coachId   String
  title     String
  videoUrl  String // e.g. YouTube or Drive link
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coach   User    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  orgId       String?
}

model Facility {
  id        String    @id @default(cuid())
  name      String // e.g. "Turf 1", "Tennis Court A"
  type      String // e.g. "PITCH", "COURT", "INDOOR"
  bookings  Booking[]
  createdAt DateTime  @default(now())
  orgId       String?

  // M4 (additive): hourly turf/court booking settings. Money amounts are whole rupees.
  hourlyRate    Int     @default(0)
  openHour      Int     @default(6) // IST, 0-23
  closeHour     Int     @default(23) // IST, 1-24 (last bookable slot ends at this hour)
  advanceAmount Int     @default(0) // online advance in rupees; 0 = collect the full amount online
  isActive      Boolean @default(true)
  turfBookings  TurfBooking[]
}

// M4 (additive): an hourly court/turf booking (walk-in, phone, academy lease, or online via Razorpay).
// Double-booking is prevented by an advisory lock + overlap check in src/lib/turf-engine.ts AND by a
// Postgres exclusion constraint (scripts/apply-turf-constraint.ts) as a last line of defence.
model TurfBooking {
  id                String    @id @default(cuid())
  orgId             String
  facilityId        String
  startTime         DateTime
  endTime           DateTime
  customerName      String
  customerPhone     String
  amount            Int // total in rupees
  advancePaid       Int       @default(0) // rupees received so far
  onlineDue         Int       @default(0) // rupees the customer must pay online to confirm (ONLINE source)
  status            String    @default("CONFIRMED") // HOLD | CONFIRMED | CANCELLED | EXPIRED | COMPLETED | NO_SHOW | PAID_CONFLICT
  source            String    @default("COUNTER") // COUNTER | ONLINE | LEASE
  holdExpiresAt     DateTime?
  providerOrderId   String?   @unique // Razorpay order id for the online advance
  providerPaymentId String?
  leaseGroupId      String? // groups the weekly repeats of one academy lease
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, startTime])
  @@index([orgId, startTime])
}

model Booking {
  id         String   @id @default(cuid())
  facilityId String
  batchId    String
  startTime  DateTime
  endTime    DateTime

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Equipment {
  id           String   @id @default(cuid())
  name         String // e.g. "Size 5 Footballs", "Training Cones"
  quantity     Int      @default(0)
  assignedToId String? // Coach ID
  createdAt    DateTime @default(now())

  assignedTo User? @relation("AssignedEquipment", fields: [assignedToId], references: [id])
  orgId       String?
}

model TrialBooking {
  id          String   @id @default(cuid())
  parentName  String
  parentPhone String
  childName   String
  childAge    Int
  batchId     String
  status      String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, NO_SHOW
  date        DateTime
  createdAt   DateTime @default(now())
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String // Parent who referred
  refereePhone String // Phone of new parent
  status       String   @default("PENDING") // PENDING, CONVERTED
  discount     Float    @default(500)
  createdAt    DateTime @default(now())
  referrer     User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
}

model Incident {
  id          String   @id @default(cuid())
  studentId   String
  coachId     String
  type        String // INJURY, MISCONDUCT, OTHER
  description String
  severity    String   @default("LOW") // LOW, MEDIUM, HIGH
  createdAt   DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coach       User     @relation("CoachIncidents", fields: [coachId], references: [id], onDelete: Cascade)
  orgId       String?
}

model Holiday {
  id        String   @id @default(cuid())
  orgId     String?
  title     String // e.g. "Diwali", "Christmas"
  date      DateTime
  createdAt DateTime @default(now())

  @@index([orgId])
}

model Waitlist {
  id          String   @id @default(cuid())
  batchId     String
  parentName  String
  parentPhone String
  childName   String
  status      String   @default("WAITING") // WAITING, NOTIFIED, ENROLLED
  createdAt   DateTime @default(now())
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orgId       String?
}

model Feedback {
  id        String   @id @default(cuid())
  parentId  String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  parent    User     @relation("ParentFeedback", fields: [parentId], references: [id], onDelete: Cascade)
  orgId       String?
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  discount   Float // percentage or flat
  type       String   @default("FLAT") // FLAT, PERCENT
  isActive   Boolean  @default(true)
  usageLimit Int      @default(100)
  usedCount  Int      @default(0)
  createdAt  DateTime @default(now())
  orgId       String?
}

model GalleryPhoto {
  id         String   @id @default(cuid())
  url        String
  caption    String?
  uploadedById String
  uploadedBy User     @relation("UploadedPhotos", fields: [uploadedById], references: [id])
  createdAt  DateTime @default(now())
  orgId       String?
}

model TransportRoute {
  id            String   @id @default(cuid())
  name          String
  driverName    String
  driverPhone   String
  vehicleNumber String
  stops         String   @default("[]")
  studentNames  String   @default("[]")
  createdAt     DateTime @default(now())
  orgId       String?
}

model FeePlan {
  id        String   @id @default(cuid())
  name      String   // "Monthly", "Quarterly", "Annual"
  duration  Int      // months: 1, 3, 12
  amount    Float    // e.g., 2500, 7000, 25000
  sport     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  orgId       String?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // "MARK_FEE_PAID", "ADD_STUDENT", "DELETE_BATCH"
  details   String?  // JSON string with context
  createdAt DateTime @default(now())
  user      User     @relation("UserAuditLogs", fields: [userId], references: [id])
  orgId       String?
  @@index([orgId, createdAt])
}

model Lead {
  id          String   @id @default(cuid())
  parentName  String
  parentPhone String
  childName   String
  childAge    Int?
  sport       String?
  source      String   @default("WALK_IN") // WALK_IN, WEBSITE, REFERRAL, SOCIAL_MEDIA, PHONE_CALL, WHATSAPP
  status      String   @default("NEW") // NEW, CONTACTED, TRIAL_BOOKED, TRIAL_ATTENDED, ENROLLED, LOST
  notes       String?
  followUpDate DateTime?
  assignedTo  String?  // coach or admin ID
  orgId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([orgId, status])
}


// Online fee payments (Razorpay / Stripe). One row per checkout attempt.
// The amount is fixed server-side from the FeeRecord when the row is created and re-checked
// against what the gateway reports, so a client can never pay less and still mark a fee PAID.
model Payment {
  id                String    @id @default(cuid())
  orgId             String
  studentId         String
  feeRecordId       String
  parentId          String
  provider          String // RAZORPAY | STRIPE
  providerOrderId   String    @unique // Razorpay order_id or Stripe checkout session id
  providerPaymentId String?
  amount            Int // minor units (paise / cents)
  currency          String // INR, USD ...
  status            String    @default("CREATED") // CREATED | PAID | FAILED
  kind              String    @default("CHECKOUT") // CHECKOUT (parent app) | LINK (Razorpay payment link sent by the academy)
  linkUrl           String? // short_url of a Razorpay payment link
  failureReason     String?
  createdAt         DateTime  @default(now())
  paidAt            DateTime?

  @@index([feeRecordId])
  @@index([orgId, status])
}

// ---------------------------------------------------------------------------
// Public directory (growth engine): academies listed from public sources
// (Google Places etc.) that can be claimed by their owners. Additive.
// ---------------------------------------------------------------------------
model ListedAcademy {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  city          String   // lowercase slug, e.g. "gurgaon"
  area          String?  // e.g. "Sector 56", "Golf Course Road"
  sports        String   // comma-separated lowercase slugs, e.g. "cricket,football"
  address       String?
  lat           Float?
  lng           Float?
  phone         String?
  website       String?
  instagram     String?
  rating        Float?
  ratingCount   Int?
  googlePlaceId String?  @unique
  source        String   @default("google_places")
  claimStatus   String   @default("UNCLAIMED") // UNCLAIMED, PENDING, CLAIMED
  claimedOrgId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leads         DirectoryLead[]
  claims        ClaimRequest[]

  @@index([city])
  @@index([claimStatus])
}

/// Parent enquiries / free-trial requests from the public directory.
model DirectoryLead {
  id              String         @id @default(cuid())
  listedAcademyId String?
  listedAcademy   ListedAcademy? @relation(fields: [listedAcademyId], references: [id])
  orgId           String?        // set when the enquiry is for a Triq academy
  parentName      String
  phone           String
  childName       String?
  childAge        Int?
  sport           String?
  message         String?
  status          String         @default("NEW") // NEW, CONTACTED, CONVERTED, SPAM
  createdAt       DateTime       @default(now())

  @@index([listedAcademyId])
  @@index([orgId])
}

/// Owner asks to claim a directory listing (verified manually / by call).
model ClaimRequest {
  id              String        @id @default(cuid())
  listedAcademyId String
  listedAcademy   ListedAcademy @relation(fields: [listedAcademyId], references: [id])
  name            String
  phone           String
  email           String?
  role            String        @default("OWNER") // OWNER, COACH, MANAGER
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime      @default(now())

  @@index([listedAcademyId])
}

/// Marketing-site leads (owner landing page, WhatsApp CTA, demo requests).
model SalesLead {
  id         String   @id @default(cuid())
  name       String
  phone      String
  academy    String?
  city       String?
  sport      String?
  students   Int?
  source     String   @default("landing") // landing, directory_claim, outbound, referral
  utm        String?
  status     String   @default("NEW") // NEW, CONTACTED, DEMO, TRIAL, WON, LOST
  notes      String?
  createdAt  DateTime @default(now())

  @@index([status])
}

// M1 (additive): DB-backed fixed-window rate limiter. The in-memory limiter in src/lib/rate-limit.ts
// resets on every serverless cold start, so abuse-sensitive limits (OTP, login) persist here.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

/// Official, verifiable digital fee receipt for parents and academies
model Receipt {
  id              String     @id @default(cuid())
  receiptNumber   String     @unique
  token           String     @unique
  orgId           String
  studentId       String
  feeRecordId     String?    @unique
  studentName     String
  parentName      String?
  parentPhone     String?
  batchName       String?
  sport           String?
  month           String     // "YYYY-MM"
  amount          Float
  paymentMode     String     @default("UPI") // UPI, CASH, RAZORPAY, BANK_TRANSFER
  transactionRef  String?
  issuedAt        DateTime   @default(now())
  createdAt       DateTime   @default(now())

  student         Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeRecord       FeeRecord? @relation(fields: [feeRecordId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([token])
  @@index([receiptNumber])
}

/// Triq SaaS subscription tiers & billing for academies
model Subscription {
  id                    String           @id @default(cuid())
  orgId                 String           @unique
  plan                  String           @default("FREE") // FREE, STARTER, PRO, ENTERPRISE
  status                String           @default("ACTIVE") // ACTIVE, TRIALING, PAST_DUE, CANCELED
  maxStudents           Int              @default(30)
  priceMonthly          Int              @default(0)
  currentPeriodStart    DateTime         @default(now())
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean          @default(false)
  razorpaySubscriptionId String?        @unique
  razorpayCustomerId   String?
  gracePeriodEndsAt     DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  org                   Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices              BillingInvoice[]

  @@index([orgId])
  @@index([status])
}

/// Triq platform billing invoices
model BillingInvoice {
  id                 String       @id @default(cuid())
  subscriptionId     String
  orgId              String
  invoiceNumber      String       @unique
  amount             Int          // In INR
  currency           String       @default("INR")
  status             String       @default("PAID")
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  paidAt             DateTime?
  pdfUrl             String?
  createdAt          DateTime     @default(now())

  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([subscriptionId])
}


// ==========================================
// TEAM: memberships, staff roles, staff attendance (Sprint 1, additive)
// ==========================================

/// Who works at which academy and in what role. One person can belong to several academies
/// (e.g. a coach at two academies). User.orgId stays the person's *active* academy.
model OrgMembership {
  id          String    @id @default(cuid())
  userId      String
  orgId       String
  role        String    // OWNER | MANAGER | COACH | STAFF
  staffRole   String?   // STAFF only: RECEPTIONIST | ACCOUNTANT | GROUNDSMAN | PHYSIO | OTHER
  title       String?   // free text shown on the team list, e.g. "Head coach"
  permissions String?   // JSON: { "<permission>": true|false } overrides on top of role defaults
  status      String    @default("ACTIVE") // INVITED | ACTIVE | REMOVED
  payType     String?   // MONTHLY | PER_SESSION
  payAmount   Int?      // in the academy's currency (whole units)
  joinedAt    DateTime  @default(now())
  removedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User          @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attendance  StaffAttendance[]
  payouts     StaffPayout[]

  @@unique([userId, orgId])
  @@index([orgId, status])
}

/// Daily attendance for coaches and staff (one row per person per day).
model StaffAttendance {
  id           String    @id @default(cuid())
  membershipId String
  orgId        String
  date         DateTime  // IST calendar day at 00:00 IST
  status       String    // PRESENT | ABSENT | LEAVE | HALF_DAY
  checkInAt    DateTime?
  checkOutAt   DateTime?
  note         String?
  markedById   String?   // user who marked it (self check-in = same person)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  membership   OrgMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([membershipId, date])
  @@index([orgId, date])
}

// ==========================================
// PAYROLL & EXPENSES (Sprint 2, additive)
// ==========================================

/// One person's pay for one month. Amounts are whole units of the academy's currency.
/// While PENDING the figures are recalculated from attendance/sessions; once PAID they are frozen.
model StaffPayout {
  id           String    @id @default(cuid())
  orgId        String
  membershipId String
  month        String    // "YYYY-MM"
  payType      String    // MONTHLY | PER_SESSION (copied from the membership when calculated)
  rate         Int       // monthly salary or per-session rate used
  units        Float     // days present (MONTHLY) or sessions taken (PER_SESSION)
  baseAmount   Int
  bonus        Int       @default(0)
  deduction    Int       @default(0)
  advance      Int       @default(0) // advance already given, subtracted from this payout
  netAmount    Int
  status       String    @default("PENDING") // PENDING | PAID
  paidAt       DateTime?
  paymentMode  String?   // CASH | UPI | BANK
  reference    String?
  note         String?
  paidById     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membership   OrgMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, month])
  @@index([orgId, month])
}

/// Money the academy spends: ground rent, equipment, travel, utilities...
model Expense {
  id          String   @id @default(cuid())
  orgId       String
  date        DateTime // IST calendar day at 00:00 (same convention as sessions)
  category    String   // RENT | EQUIPMENT | UTILITIES | TRAVEL | MARKETING | EVENTS | OTHER
  amount      Int
  note        String?
  paymentMode String?  // CASH | UPI | BANK | CARD
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, date])
}

// ==========================================
// V2 TRIQ ATHLETE (additive, flags athleteOS / opportunities)
// SQL: prisma/sql/2026-10-26_athlete_vertical.sql. Foreign keys to Student/Organization/User live in
// the SQL only (no back-relations on existing models, so existing queries are untouched).
// ==========================================

/// An achievement or competition result. Status is explicit: SUBMITTED -> REVIEWED -> VERIFIED (or REJECTED).
/// Only academy staff with students.manage can set VERIFIED. Rules: src/lib/athlete.ts.
model AthleteAchievement {
  id              String    @id @default(cuid())
  orgId           String
  studentId       String
  kind            String    @default("ACHIEVEMENT") // ACHIEVEMENT | COMPETITION
  title           String
  competition     String?
  level           String    @default("OTHER") // CLUB | SCHOOL | DISTRICT | STATE | NATIONAL | INTERNATIONAL | OTHER
  result          String?
  eventDate       DateTime
  evidenceUrl     String?
  notes           String?
  status          String    @default("SUBMITTED") // SUBMITTED | REVIEWED | VERIFIED | REJECTED
  submittedById   String
  submittedByRole String    // PARENT | COACH | ADMIN
  reviewedById    String?
  reviewedAt      DateTime?
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId, status])
  @@index([studentId, eventDate])
}

/// A development goal a coach sets for an athlete.
model AthleteGoal {
  id         String    @id @default(cuid())
  orgId      String
  studentId  String
  setById    String
  title      String
  metric     String?
  baseline   Float?
  target     Float?
  dueDate    DateTime?
  status     String    @default("ACTIVE") // ACTIVE | ACHIEVED | DROPPED
  notes      String?
  achievedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orgId])
  @@index([studentId, status])
}

/// A trial, scholarship, camp or recruitment opportunity an academy shares with its families.
model Opportunity {
  id           String    @id @default(cuid())
  orgId        String
  title        String
  kind         String    @default("TRIAL") // TRIAL | SCHOLARSHIP | CAMP | TOURNAMENT | RECRUITMENT | OTHER
  sport        String?
  location     String?
  startDate    DateTime?
  endDate      DateTime?
  applyBy      DateTime
  ageMin       Int?
  ageMax       Int?
  url          String?
  description  String?
  batchId      String?   // null = whole academy
  status       String    @default("DRAFT") // DRAFT | OPEN | CLOSED
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications OpportunityApplication[]
// TRIQ Play (additive, prisma/sql/2026-10-26_competitions.sql). Read only when FEATURES.events is on.
// Rules live in src/lib/competition.ts; standings are always computed, never stored.
// ==========================================

model Competition {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  sport           String?
  format          String    // LEAGUE | KNOCKOUT
  entryType       String    @default("TEAM") // TEAM | INDIVIDUAL
  legs            Int       @default(1) // LEAGUE: 1 or 2
  status          String    @default("DRAFT") // DRAFT | OPEN | SCHEDULED | COMPLETED | CANCELLED
  startDate       DateTime?
  endDate         DateTime?
  venue           String?
  maxEntries      Int
  minAge          Int?
  maxAge          Int?
  ageCutoffDate   DateTime?
  eligibleBatchId String?
  pointsWin       Int       @default(3)
  pointsDraw      Int       @default(1)
  pointsLoss      Int       @default(0)
  allowDraws      Boolean   @default(true)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries  CompetitionEntry[]
  fixtures Fixture[]

  @@index([orgId, status])
}

/// A guardian-consented application for one athlete to one opportunity.
model OpportunityApplication {
  id              String   @id @default(cuid())
  orgId           String
  opportunityId   String
  studentId       String
  parentId        String
  status          String   @default("APPLIED") // APPLIED | SHORTLISTED | SELECTED | NOT_SELECTED | WITHDRAWN
  guardianConsent Boolean  @default(false)
  consentAt       DateTime?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  events          OpportunityApplicationEvent[]

  @@unique([opportunityId, studentId])
  @@index([orgId, status])
  @@index([studentId])
}

/// Append-only status history of an application.
model OpportunityApplicationEvent {
// ---- V5 TRIQ Careers (additive, 2026-10-26; prisma/sql/2026-10-26_careers.sql) ----------------
// No relations are added to existing models, so this block is purely additive.

/// A user's portable professional profile (user-owned, not org-scoped).
model ProfessionalProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  headline        String?
  bio             String?
  sports          String[] @default([])
  city            String?
  yearsExperience Int?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProfessionalExperience {
  id           String   @id @default(cuid())
  userId       String
  title        String
  organization String
  startYear    Int
  endYear      Int?
  description  String?
  createdAt    DateTime @default(now())
  @@index([userId])
}

/// Qualification or certification. status: SUBMITTED | REVIEWED | VERIFIED | REJECTED (src/lib/credentials.ts).
model ProfessionalCredential {
  id           String    @id @default(cuid())
  userId       String
  kind         String    // QUALIFICATION | CERTIFICATION
  title        String
  issuer       String?
  issuedYear   Int?
  evidenceUrl  String?
  status       String    @default("SUBMITTED")
  reviewedById String?
  reviewedAt   DateTime?
  verifiedById String?
  verifiedAt   DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([userId])
  @@index([status])
}

/// Job posted by an organisation. status: DRAFT | OPEN | CLOSED.
model JobListing {
  id             String   @id @default(cuid())
  orgId          String
  title          String
  role           String
  sport          String?
  city           String
  employmentType String
  description    String
  requirements   String?
  payMin         Int?
  payMax         Int?
  currency       String   @default("INR")
  status         String   @default("DRAFT")
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([orgId, status])
  @@index([status, createdAt])
}

/// status: APPLIED | SHORTLISTED | INTERVIEW | OFFERED | HIRED | REJECTED | WITHDRAWN.
model JobApplication {
  id          String   @id @default(cuid())
  orgId       String
  jobId       String
  applicantId String
  coverNote   String?
  status      String   @default("APPLIED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([jobId, applicantId])
  @@index([orgId, jobId])
  @@index([applicantId])
}

/// Every application status change (history shown to employer and applicant).
model JobApplicationEvent {
  id            String   @id @default(cuid())
  orgId         String
  applicationId String
  fromStatus    String?
  toStatus      String
  actorId       String
  note          String?
  createdAt     DateTime @default(now())

  application   OpportunityApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([orgId])
}

// ==========================================
// V10 TRIQ EDUCATION (additive, flag education)
// SQL: prisma/sql/2026-10-26_education.sql. An institution is an Organization with an
// InstitutionProfile row; teams/squads reuse existing Batches (roster, coach, sessions, attendance).
// ==========================================

/// Marks an organization as a school / college / university.
model InstitutionProfile {
  id          String   @id @default(cuid())
  orgId       String   @unique
  kind        String   // SCHOOL | COLLEGE | UNIVERSITY
  affiliation String?  // board / university, e.g. "CBSE"
  levels      String?  // e.g. "Grades 1-12"
  website     String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A sports department / program inside an institution, e.g. "Football".
model SportsProgram {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  sport       String
  description String?
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams          ProgramTeam[]
  participations ParticipationRecord[]

  @@index([orgId, status])
}

/// Maps an existing Batch onto a program as a team / squad. A batch belongs to at most one program.
model ProgramTeam {
  id        String   @id @default(cuid())
  orgId     String
  programId String
  batchId   String   @unique
  squadType String   @default("TEAM") // TEAM | SQUAD | CLUB
  ageGroup  String?
  gender    String?  // BOYS | GIRLS | MIXED
  createdAt DateTime @default(now())

  program   SportsProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([programId])
}

/// A student's participation beyond routine training attendance: events, competitions, selections.
model ParticipationRecord {
  id           String   @id @default(cuid())
  orgId        String
  programId    String
  studentId    String
  teamId       String?
  kind         String   // TRAINING | EVENT | COMPETITION | SELECTION | ACHIEVEMENT
  title        String
  date         DateTime
  role         String?
  result       String?
  notes        String?
  recordedById String
  createdAt    DateTime @default(now())

  program      SportsProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([orgId, programId, date])
  @@index([studentId])
/// A physical location of an academy (multi-centre academies). Plan Phase 3: academy & branch setup.
model Branch {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  batches   BatchBranch[]

  @@unique([orgId, name])
  @@index([orgId])
}

/// V1 Business (additive, flag `branches`): which branch a batch runs at (at most one).
/// Read and written only when FEATURES.branches is on (SQL: prisma/sql/2026-10-26_batch_branches.sql).
model BatchBranch {
  batchId   String   @id
  orgId     String
  branchId  String
  createdAt DateTime @default(now())
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([branchId])
model CompetitionEntry {
  id             String   @id @default(cuid())
  orgId          String
  competitionId  String
  name           String
  studentId      String?  // INDIVIDUAL entries
  batchId        String?  // optional source batch for TEAM entries
  seed           Int?
  status         String   @default("REGISTERED") // REGISTERED | WITHDRAWN
  registeredById String
  createdAt      DateTime @default(now())

  competition  Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  student      Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  homeFixtures Fixture[]   @relation("FixtureHome")
  awayFixtures Fixture[]   @relation("FixtureAway")
  wonFixtures  Fixture[]   @relation("FixtureWinner")

  @@unique([competitionId, name])
  @@unique([competitionId, studentId])
  @@index([orgId])
}

model Fixture {
  id             String    @id @default(cuid())
  orgId          String
  competitionId  String
  round          Int
  slot           Int
  homeEntryId    String?
  awayEntryId    String?
  scheduledAt    DateTime?
  venue          String?
  status         String    @default("SCHEDULED") // SCHEDULED | COMPLETED | BYE | POSTPONED | CANCELLED
  homeScore      Int?
  awayScore      Int?
  winnerEntryId  String?
  officialUserId String?   // coach/staff allowed to record this fixture's result
  resultById     String?
  resultAt       DateTime?
  version        Int       @default(0) // optimistic concurrency: every write must match and bump it
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  competition Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  home        CompetitionEntry? @relation("FixtureHome", fields: [homeEntryId], references: [id], onDelete: SetNull)
  away        CompetitionEntry? @relation("FixtureAway", fields: [awayEntryId], references: [id], onDelete: SetNull)
  winner      CompetitionEntry? @relation("FixtureWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)

  @@unique([competitionId, round, slot])
  @@index([orgId, scheduledAt])
  @@index([officialUserId])
// ---- V6 TRIQ Wellness (additive, 2026-10-26; prisma/sql/2026-10-26_wellness.sql) ---------------

/// A wellness professional's service profile (user-owned). credentialStatus uses src/lib/credentials.ts.
model WellnessProvider {
  id                   String    @id @default(cuid())
  userId               String    @unique
  displayName          String
  category             String    // PHYSIOTHERAPY | NUTRITION | RECOVERY | PSYCHOLOGY
  services             String?
  bio                  String?
  city                 String?
  registrationBody     String?
  registrationNumber   String?   // never shown on discovery pages
  credentialStatus     String    @default("SUBMITTED")
  credentialReviewedById String?
  credentialReviewedAt DateTime?
  credentialVerifiedById String?
  credentialVerifiedAt DateTime?
  credentialRejectReason String?
  isListed             Boolean   @default(false)
  acceptingRequests    Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  @@index([isListed, category])
}

/// status: REQUESTED | CONFIRMED | DECLINED | COMPLETED | CANCELLED (src/lib/wellness.ts).
/// `note` is sensitive: visible only to the requester and the provider, never audited.
model WellnessAppointment {
  id             String    @id @default(cuid())
  providerId     String
  providerUserId String
  requesterId    String
  category       String
  scheduledAt    DateTime
  note           String?
  status         String    @default("REQUESTED")
  confirmedAt    DateTime?
  declinedAt     DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([providerUserId, status, scheduledAt])
  @@index([requesterId, createdAt])
}
