datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// MULTI-TENANT: ORGANIZATION
// ==========================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sport       String?
  city        String
  state       String
  phone       String?
  email       String?
  logo        String?
  address     String?
  plan        String   @default("FREE_TRIAL")
  planExpiry  DateTime?
  pincode     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Phase 0 (additive): payments & fee defaults
  upiId             String?  // e.g. "academy@okicici" — used for "Pay via UPI" links/QR
  defaultMonthlyFee Int?     // fallback fee (₹) when batch/student has none
  coachSessionRate  Int?     // optional ₹ per session, used to estimate coach payouts

  // M1 (additive): what kind of business signed up. ACADEMY | TURF | BOTH
  businessType      String   @default("ACADEMY")

  // White-label (additive): partner/academy accent + "Powered by Triq" toggle on shared cards
  brandColor        String?  // hex, e.g. "#a3e635"; null = Triq lime
  hidePoweredBy     Boolean  @default(false)

  // Globalisation (additive): per-academy locale. Defaults filled at signup.
  country       String   @default("IN")       // ISO 3166-1 alpha-2
  currency      String   @default("INR")      // ISO 4217
  timezone      String   @default("Asia/Kolkata")
  locale        String   @default("en-IN")    // BCP-47
  phoneCountry  String   @default("91")       // calling code without +

  // Photos of the facility (up to 6), shown on public listing and OG card.
  // Hosted on Vercel Blob; first entry is the hero image.
  photos        String[] @default([])

  // M3 (additive): the academy's OWN Razorpay account. Money settles to the academy, never to Triq.
  // Secrets are AES-256-GCM encrypted (src/lib/secret-box.ts) and must never be sent to the client.
  razorpayKeyId            String?
  razorpayKeySecretEnc     String?
  razorpayWebhookSecretEnc String?
  razorpayConnectedAt      DateTime?

  users       User[]
  students    Student[]
  batches     Batch[]
  branches    Branch[]
  subscription Subscription?
  memberships     OrgMembership[]
  staffAttendance StaffAttendance[]
  staffPayouts    StaffPayout[]
  expenses        Expense[]
  competitions    Competition[]
}

// ==========================================
// V1 LEAN MVP: ACADEMY WORKFORCE
// ==========================================

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  email     String?  @unique
  password  String?
  name      String
  role      String   @default("PARENT") // SUPER_ADMIN, ADMIN, COACH, PARENT
  verificationData String?  // JSON: { steps: [{name, status, uploadUrl?, verifiedAt?}] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId            String?
  org              Organization? @relation(fields: [orgId], references: [id])

  children         Student[]
  batches          Batch[] // Batches where this user is the COACH
  skillReports     SkillReport[]
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  rsvps            RSVP[]
  Media            Media[]
  equipment        Equipment[]   @relation("AssignedEquipment")
  referrals        Referral[]
  incidents        Incident[]    @relation("CoachIncidents")
  feedback         Feedback[]    @relation("ParentFeedback")
  verified         Boolean       @default(false)
  lastSeenAt       DateTime?     // throttled "last used the app" (requireAuth)
  sessionVersion   Int           @default(0) // M1: bump to revoke every existing session cookie
  uploadedPhotos   GalleryPhoto[] @relation("UploadedPhotos")
  auditLogs        AuditLog[]    @relation("UserAuditLogs")
  loginTokens      LoginToken[]
  memberships      OrgMembership[]   @relation("UserMemberships")
  @@index([orgId])
}

model Student {
  id          String   @id @default(cuid())
  parentId    String
  name        String
  dob         DateTime? // optional: many academy rosters don't have it
  medicalInfo String?
  points      Int      @default(0)
  dietPlanUrl String? // e.g. Asthma, Allergies
  bloodGroup  String?
  feeOverride Int?     // Phase 0: per-student monthly fee (₹), overrides batch/org fee
  createdAt   DateTime @default(now())

  parent       User              @relation(fields: [parentId], references: [id], onDelete: Cascade)
  orgId        String?
  org          Organization?     @relation(fields: [orgId], references: [id])
  enrollments  BatchEnrollment[]
  events       Event[]
  feeRecords   FeeRecord[]
  attendances  Attendance[]
  skillReports SkillReport[]
  RSVP         RSVP[]
  Order        Order[]
  Media        Media[]
  incidents    Incident[]
  receipts     Receipt[]
  competitionEntries CompetitionEntry[]
  @@index([orgId])
  @@index([parentId])
}

model Batch {
  id        String   @id @default(cuid())
  coachId   String
  name      String // e.g., "U-14 Football Beginners"
  sport     String
  schedule  String // e.g., "Mon/Wed/Fri 4:00 PM"
  monthlyFee Int?    // Phase 0: monthly fee (₹) for students in this batch
  capacity   Int?    // Phase 0: optional max students
  createdAt DateTime @default(now())

  coach         User              @relation(fields: [coachId], references: [id])
  orgId         String?
  org           Organization?     @relation(fields: [orgId], references: [id])
  // Which branch (location) this batch runs at lives in BatchBranch, NOT a Batch column: Prisma selects
  // every Batch scalar on every batch query, so a new column would break production before its SQL is applied.
  branchLink    BatchBranch?
  enrollments   BatchEnrollment[]
  sessions      Session[]
  Event         Event[]
  Booking       Booking[]
  trialBookings TrialBooking[]
  waitlist      Waitlist[]
  @@index([orgId])
  @@index([coachId])
}

model BatchEnrollment {
  id        String   @id @default(cuid())
  batchId   String
  studentId String
  joinedAt  DateTime @default(now())

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([studentId])
}

model Session {
  id        String   @id @default(cuid())
  batchId   String
  date      DateTime // The specific date this session happened
  status    String   @default("COMPLETED") // SCHEDULED, COMPLETED, CANCELLED
  recap        String?   // Coach's post-session recap shared with parents
  cancelReason String?   // Set when status = CANCELLED
  createdAt DateTime @default(now())

  @@unique([batchId, date])

  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  orgId       String?
}

model Attendance {
  id        String  @id @default(cuid())
  sessionId String
  studentId String
  isPresent Boolean @default(false)
  status    String? // PRESENT, ABSENT, LATE, EXCUSED (null on legacy rows → derive from isPresent)
  notes     String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

