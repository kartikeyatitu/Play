# Triq: environment variables (copy into .env.local / Vercel project settings). Never commit values.

# ── App URL ───────────────────────────────────────────────────────────
# Public base URL for links (login links, receipts, webhooks shown in Settings, SEO). Resolution order
# (src/lib/app-url.ts): NEXT_PUBLIC_APP_URL → NEXT_PUBLIC_SITE_URL → https://$VERCEL_PROJECT_PRODUCTION_URL
# (set automatically by Vercel) → http://localhost:3000. Inlined at build time: redeploy after changing.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# ── Phone login (OTP) ─────────────────────────────────────────────────
# Order: WhatsApp authentication template (if configured) → SMS fallback.
# SMS: MSG91 for Indian (+91) numbers; Twilio ONLY for non-Indian numbers (Twilio SMS to India needs DLT).
# With no channel for a number, login says "SMS login isn't available yet" and admins use one-tap login links.
# MSG91 → API → Auth key (sent as an HTTP header), and a DLT-approved SendOTP template id (must contain ##OTP##)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio (international users only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Demo / QA only: these numbers get OTP_TEST_CODE without any message being sent. Both must be set.
OTP_TEST_PHONES=
OTP_TEST_CODE=

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────
# System-user permanent token with whatsapp_business_messaging; Phone number ID and WABA ID from WhatsApp Manager
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Approved AUTHENTICATION template (copy-code button, language "en") used for login codes
WHATSAPP_AUTH_TEMPLATE_NAME=
# Optional. Default https://graph.facebook.com/v25.0 (v18.0 stopped working in Jan 2026)
WHATSAPP_API_URL=
# Webhook: Callback URL https://<your-domain>/api/webhooks/whatsapp, Verify token = WHATSAPP_WEBHOOK_VERIFY_TOKEN.
# POSTs are verified with the Meta App Secret (App settings → Basic); without it every POST is rejected.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Academy fee payments ──────────────────────────────────────────────
# Primary path: each academy pastes ITS OWN Razorpay keys in Settings → Online payments (stored encrypted
# with PAYMENTS_ENC_KEY) and adds the webhook https://<your-domain>/api/webhooks/razorpay/<academy-id>.
# Fee money settles straight to the academy. Without that, parents pay by UPI and tap "I've paid".
PAYMENTS_ENC_KEY=
# Collect academy fees into TRIQ'S OWN Stripe account. Default off: holding academy money in the platform
# account makes Triq a payment aggregator under RBI rules. Only set to "true" once that is resolved.
PLATFORM_COLLECTS_FEES=

# ── Razorpay: Triq platform account (SaaS billing) ────────────────────
# Dashboard → Account & Settings → API Keys (use rzp_test_… keys while testing). Triq's own subscriptions only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Subscriptions webhook: https://<your-domain>/api/webhooks/razorpay/billing
# Events: subscription.authenticated, .activated, .charged, .pending, .halted, .paused, .resumed,
#         .cancelled, .completed. Required: no fallback to RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_BILLING_WEBHOOK_SECRET=
# LEGACY platform fee webhook (/api/webhooks/razorpay) for old platform-collected orders only.
RAZORPAY_WEBHOOK_SECRET=

# ── Stripe (platform account; fee checkout only with PLATFORM_COLLECTS_FEES=true) ──
# Developers → API keys (use sk_test_… while testing)
STRIPE_SECRET_KEY=
# Developers → Webhooks → Add endpoint: https://<your-domain>/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=
# Currency for Stripe charges (Stripe India accounts support INR). Default: INR
STRIPE_CURRENCY=INR

# Local testing of webhooks:
#   Razorpay: expose localhost with a tunnel (e.g. `cloudflared tunnel --url http://localhost:3000`) and use that URL in the dashboard.
#   Stripe:   `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints the whsec_… to use as STRIPE_WEBHOOK_SECRET.

# ── Observability (all optional; each tool stays OFF while its key is empty) ──
# Sentry server/edge error + trace reporting. Sentry → Project Settings → Client Keys (DSN)
SENTRY_DSN=
# Sentry in the browser (same DSN as above; inlined at build time, so redeploy after changing it)
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time: all three must be set, otherwise upload is skipped (build still succeeds)
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry → Settings → Auth Tokens (org token). Build-time secret only; never prefix with NEXT_PUBLIC_
SENTRY_AUTH_TOKEN=
# PostHog product analytics. Project Settings → Project API key (phc_…); inlined at build time
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingest host (optional). Default https://us.i.posthog.com; EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
# Sentry's environment tag comes from VERCEL_ENV / NEXT_PUBLIC_VERCEL_ENV, which Vercel sets automatically.

# ── Scheduled jobs (Vercel Cron) ──────────────────────────────────────
# Shared secret for internal cron endpoints (e.g. /api/cron/monthly-fees). The route
# checks `Authorization: Bearer $CRON_SECRET` and fails CLOSED if this is unset.
# Vercel Cron attaches this header automatically when the env var is set on the project.
CRON_SECRET=
