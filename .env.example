# Triq: environment variables for ONLINE FEE PAYMENTS (copy into .env / Vercel project settings).
# With none of these set, the app keeps working exactly as today: parents pay by UPI and tap "I've paid",
# and the academy confirms. The "Pay online" button only appears once a gateway is configured.

# ── Razorpay (India, INR) ─────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys (use rzp_test_… keys while testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add URL: https://<your-domain>/api/webhooks/razorpay
# Events: payment.captured, order.paid, payment.failed. Paste the secret you choose there:
RAZORPAY_WEBHOOK_SECRET=

# ── Stripe (cards; international) ─────────────────────────────────────
# Developers → API keys (use sk_test_… while testing)
STRIPE_SECRET_KEY=
# Developers → Webhooks → Add endpoint: https://<your-domain>/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=
# Currency for Stripe charges (Stripe India accounts support INR). Default: INR
STRIPE_CURRENCY=INR

# Public base URL used to build Stripe's return links (optional; falls back to the request host)
NEXT_PUBLIC_APP_URL=

# Local testing of webhooks:
#   Razorpay: expose localhost with a tunnel (e.g. `cloudflared tunnel --url http://localhost:3000`) and use that URL in the dashboard.
#   Stripe:   `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints the whsec_… to use as STRIPE_WEBHOOK_SECRET.

# ── Observability (all optional; each tool stays OFF while its key is empty) ──
# Sentry server/edge error + trace reporting. Sentry → Project Settings → Client Keys (DSN)
SENTRY_DSN=
# Sentry in the browser (same DSN as above; inlined at build time, so redeploy after changing it)
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time: all three must be set, otherwise upload is skipped (build still succeeds)
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry → Settings → Auth Tokens (org token). Build-time secret only; never prefix with NEXT_PUBLIC_
SENTRY_AUTH_TOKEN=
# PostHog product analytics. Project Settings → Project API key (phc_…); inlined at build time
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingest host (optional). Default https://us.i.posthog.com; EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
# Sentry's environment tag comes from VERCEL_ENV / NEXT_PUBLIC_VERCEL_ENV, which Vercel sets automatically.
